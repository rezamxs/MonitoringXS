<UserControl
    x:Class="MonitoringXS.App.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MonitoringXS.App.ViewModels"
    x:Uid="DiagnosticsPageRoot"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="DiagnosticItemTemplate" x:DataType="vm:DiagnosticItem">
            <Border
                Padding="4,10"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{x:Bind Label, Mode=OneTime}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FlowDirection="{x:Bind ValueFlowDirection, Mode=OneTime}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{x:Bind Value, Mode=OneTime}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{x:Bind Detail, Mode=OneTime}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="24,16,24,24" Background="{StaticResource PageBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Repair" />
                            <TextBlock x:Uid="DiagnosticsPageTitle"
                                Grid.Column="1"
                                Style="{StaticResource PageTitleStyle}" />
                        </Grid>
                        <TextBlock x:Uid="DiagnosticsIntroduction"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <ProgressRing x:Uid="DiagnosticsRefreshProgress"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsRefreshing, Mode=OneWay}" />
                </Grid>

                <!-- Beginner-friendly summary -->
                <Border
                    Style="{StaticResource SectionSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            FontSize="16"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding BeginnerSummaryText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding BeginnerStatusRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,2" RowSpacing="3" ColumnSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Label}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{Binding StatusForeground}"
                                            FontWeight="SemiBold"
                                            Text="{Binding Status}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="{Binding Explanation}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="DiagnosticsRefreshButton"
                        Command="{Binding RefreshCommand}"
                        UseSystemFocusVisuals="True" />
                    <Button x:Uid="DiagnosticsCopyButton"
                        Command="{Binding CopySafeSummaryCommand}"
                        UseSystemFocusVisuals="True" />
                </StackPanel>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding CopyStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <Border Style="{StaticResource SectionSurfaceStyle}">
                    <StackPanel Spacing="2">
                        <Expander x:Uid="DiagnosticsApplicationSection" IsExpanded="False">
                            <ItemsControl Margin="0,4,0,8"
                                ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                ItemsSource="{Binding ApplicationItems, Mode=OneWay}" />
                        </Expander>
                        <Expander x:Uid="DiagnosticsCollectorsSection" IsExpanded="False">
                            <ItemsControl Margin="0,4,0,8"
                                ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                ItemsSource="{Binding CollectorItems, Mode=OneWay}" />
                        </Expander>
                        <Expander x:Uid="DiagnosticsServiceSection" IsExpanded="False">
                            <ItemsControl Margin="0,4,0,8"
                                ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                ItemsSource="{Binding ServiceItems, Mode=OneWay}" />
                        </Expander>
                        <Expander x:Uid="DiagnosticsStorageSection" IsExpanded="False">
                            <ItemsControl Margin="0,4,0,8"
                                ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                ItemsSource="{Binding StorageItems, Mode=OneWay}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionSurfaceStyle}">
                    <Expander x:Uid="DiagnosticsAdvancedSection" IsExpanded="False">
                        <ItemsControl Margin="0,4,0,8"
                            ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                            ItemsSource="{Binding AdvancedItems, Mode=OneWay}" />
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

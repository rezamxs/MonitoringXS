<Application
    x:Class="MonitoringXS.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageColor">#0B1017</Color>
                    <Color x:Key="SurfaceColor">#141C27</Color>
                    <Color x:Key="SurfaceRaisedColor">#1B2634</Color>
                    <Color x:Key="PrimaryTextColor">#F2F7FA</Color>
                    <Color x:Key="SecondaryTextColor">#A9BAC6</Color>
                    <Color x:Key="BorderColor">#304153</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageColor">#F3F6F8</Color>
                    <Color x:Key="SurfaceColor">#FFFFFF</Color>
                    <Color x:Key="SurfaceRaisedColor">#F7FAFC</Color>
                    <Color x:Key="PrimaryTextColor">#111B24</Color>
                    <Color x:Key="SecondaryTextColor">#526575</Color>
                    <Color x:Key="BorderColor">#CFD9E1</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="PageColor">Black</Color>
                    <Color x:Key="SurfaceColor">Black</Color>
                    <Color x:Key="SurfaceRaisedColor">Black</Color>
                    <Color x:Key="PrimaryTextColor">White</Color>
                    <Color x:Key="SecondaryTextColor">White</Color>
                    <Color x:Key="BorderColor">White</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="PageBrush" Color="{ThemeResource PageColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource BorderColor}" />
            <SolidColorBrush x:Key="DataAccentBrush" Color="#28C7FA" />
            <SolidColorBrush x:Key="PriorityAccentBrush" Color="#8B7CFF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Segoe UI Variable" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application
    x:Class="MonitoringXS.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageColor">#0A0A0B</Color>
                    <Color x:Key="ShellColor">#101012</Color>
                    <Color x:Key="SurfaceColor">#171719</Color>
                    <Color x:Key="SurfaceRaisedColor">#212124</Color>
                    <Color x:Key="ToolbarColor">#E619191C</Color>
                    <Color x:Key="PrimaryTextColor">#F4F4F5</Color>
                    <Color x:Key="SecondaryTextColor">#B3B3BA</Color>
                    <Color x:Key="BorderColor">#35353A</Color>
                    <Color x:Key="DataAccentColor">#28C7FA</Color>
                    <Color x:Key="PriorityAccentColor">#8B7CFF</Color>
                    <Color x:Key="WarningColor">#F5B942</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageColor">#F3F6F8</Color>
                    <Color x:Key="ShellColor">#F7F9FA</Color>
                    <Color x:Key="SurfaceColor">#F9FBFC</Color>
                    <Color x:Key="SurfaceRaisedColor">#EDF2F5</Color>
                    <Color x:Key="ToolbarColor">#E6FFFFFF</Color>
                    <Color x:Key="PrimaryTextColor">#111B24</Color>
                    <Color x:Key="SecondaryTextColor">#526575</Color>
                    <Color x:Key="BorderColor">#CFD9E1</Color>
                    <Color x:Key="DataAccentColor">#006D91</Color>
                    <Color x:Key="PriorityAccentColor">#5E50C8</Color>
                    <Color x:Key="WarningColor">#8A5A00</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="ShellColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="SurfaceColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="SurfaceRaisedColor" ResourceKey="SystemColorButtonFaceColor" />
                    <StaticResource x:Key="ToolbarColor" ResourceKey="SystemColorButtonFaceColor" />
                    <StaticResource x:Key="PrimaryTextColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="SecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="BorderColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="DataAccentColor" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="PriorityAccentColor" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="WarningColor" ResourceKey="SystemColorHotlightColor" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="PageBrush" Color="{ThemeResource PageColor}" />
            <SolidColorBrush x:Key="ShellBrush" Color="{ThemeResource ShellColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ToolbarBrush" Color="{ThemeResource ToolbarColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource BorderColor}" />
            <SolidColorBrush x:Key="DataAccentBrush" Color="{ThemeResource DataAccentColor}" />
            <SolidColorBrush x:Key="PriorityAccentBrush" Color="{ThemeResource PriorityAccentColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Segoe UI Variable" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="CardIdentityStyle" TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="CardMetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="CardMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style
                x:Key="CardPrimaryMetricValueStyle"
                BasedOn="{StaticResource CardMetricValueStyle}"
                TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Segoe UI Variable" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource DataAccentBrush}" />
            </Style>
            <Style x:Key="CardSupportingTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="CardPrimaryMetricPanelStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SectionSurfaceStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="MetricSurfaceStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

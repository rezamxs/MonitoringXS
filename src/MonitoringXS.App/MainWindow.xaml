<Window
    x:Class="MonitoringXS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    xmlns:local="using:MonitoringXS.App"
    xmlns:vm="using:MonitoringXS.App.ViewModels"
    Title="Monitoring XS">
    <Grid x:Name="Root" Background="{StaticResource PageBrush}">
        <Grid.Resources>
        <DataTemplate x:Key="ApplicationDetailTemplate">
            <ScrollViewer>
                <StackPanel Padding="24" Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource SectionTitleStyle}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding ProcessSummary}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding CpuText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Working set" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding MemoryText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O read" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoReadText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O write" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoWriteText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Physical disk (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Physical disk read rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Read" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskReadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Physical disk write rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Write" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskWriteText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding PhysicalDiskStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Network download rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Download" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkDownloadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Network upload rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Upload" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkUploadText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding NetworkStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="CPU · last minute" />
                        <controls:MetricSparkline
                            AutomationProperties.Name="CPU history for the selected application"
                            Samples="{Binding CpuSamples}" />
                    </StackPanel>
                    <Expander Header="Advanced application information">
                        <StackPanel Padding="0,12,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Classification evidence" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationConfidence}" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationReason}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Physical-disk session totals" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskOperationsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Network session details" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkEndpointsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="Process-level tables, command lines, GPU, and security fields are not implemented in this vertical slice."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationCardTemplate" x:DataType="vm:ApplicationCardViewModel">
            <Border
                Margin="0,0,0,10"
                Padding="16"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind Publisher, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind CpuText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Memory" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind ProcessCountText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O" />
                        <TextBlock
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind IoText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Physical disk (ETW)" />
                        <TextBlock
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind PhysicalDiskText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Network" />
                        <TextBlock
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{x:Bind NetworkText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind NetworkStatusText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationSectionTemplate" x:DataType="vm:ApplicationSectionViewModel">
            <StackPanel Margin="0,16,0,8" Spacing="4">
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{x:Bind Title, Mode=OneTime}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Bind Description, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <local:ApplicationListTemplateSelector
            x:Key="ApplicationListTemplateSelector"
            ApplicationTemplate="{StaticResource ApplicationCardTemplate}"
            SectionTemplate="{StaticResource ApplicationSectionTemplate}" />

        <Style x:Key="ApplicationListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        </Grid.Resources>

        <Grid>
        <NavigationView
            x:Name="PrimaryNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            PaneTitle="Monitoring XS">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" IsEnabled="False" Tag="dashboard" />
                <NavigationViewItem Content="Running Apps" Icon="AllApps" IsSelected="True" Tag="running" />
                <NavigationViewItem Content="Portable Apps" Icon="OpenFile" IsEnabled="False" Tag="portable" />
                <NavigationViewItem Content="History" Icon="Clock" IsEnabled="False" Tag="history" />
                <NavigationViewItem Content="Settings" Icon="Setting" IsEnabled="False" Tag="settings" />
                <NavigationViewItem Content="About" Icon="Help" IsEnabled="False" Tag="about" />
            </NavigationView.MenuItems>
            <TabView
                x:Name="WorkspaceTabs"
                IsAddTabButtonVisible="False"
                TabCloseRequested="WorkspaceTabs_TabCloseRequested">
                <TabViewItem Header="Running Apps" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="24,20,24,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="Running applications" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                Header="Advanced mode"
                                IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                Toggled="AdvancedMode_Toggled"
                                AutomationProperties.Name="Show advanced application information" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            Margin="24,0,24,24"
                            AutomationProperties.Name="Running applications"
                            ContainerContentChanging="ApplicationList_ContainerContentChanging"
                            IsItemClickEnabled="True"
                            ItemClick="ApplicationList_ItemClick"
                            ItemContainerStyle="{StaticResource ApplicationListItemStyle}"
                            ItemsSource="{x:Bind ViewModel.ApplicationItems, Mode=OneWay}"
                            ItemTemplateSelector="{StaticResource ApplicationListTemplateSelector}"
                            SelectionMode="None">
                            <ListView.Header>
                                <Border
                                    x:Name="AdvancedModeNotice"
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource PriorityAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Advanced mode is on. Open an application tab and expand Advanced application information for attribution evidence and implementation availability."
                                        TextWrapping="Wrap" />
                                </Border>
                            </ListView.Header>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
        </NavigationView>
        </Grid>
    </Grid>
</Window>

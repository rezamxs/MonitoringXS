<Window
    x:Class="MonitoringXS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    xmlns:local="using:MonitoringXS.App"
    xmlns:vm="using:MonitoringXS.App.ViewModels"
    Title="Monitoring XS">
    <Grid
        x:Name="Root"
        Background="{StaticResource PageBrush}">
        <Grid.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="ApplicationDetailTemplate">
            <ScrollViewer>
                <StackPanel Padding="24" Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource SectionTitleStyle}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding ProcessSummary}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding CpuText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Working set" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding MemoryText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O read" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoReadText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O write" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoWriteText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Physical disk (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Physical disk read rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Read" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskReadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Physical disk write rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Write" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskWriteText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding PhysicalDiskStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Network download and receive rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Download / Receive" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkDownloadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Network upload and send rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Upload / Send" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkUploadText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding NetworkStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="GPU (Windows performance counters)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="GPU utilization"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Busiest engine" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding GpuUsageText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Dedicated GPU memory reported for application processes"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Dedicated memory" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding DedicatedGpuMemoryText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="16"
                                AutomationProperties.Name="Shared GPU memory reported for application processes"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Shared memory" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding SharedGpuMemoryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding GpuStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="CPU · last minute" />
                        <controls:MetricSparkline
                            AutomationProperties.Name="CPU history for the selected application"
                            Samples="{Binding CpuSamples}" />
                    </StackPanel>
                    <Expander Header="Advanced application information">
                        <StackPanel Padding="0,12,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Classification evidence" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationConfidence}" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationReason}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Physical-disk session totals" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskOperationsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Network session details" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkEndpointsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="GPU counter details" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding GpuDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="Process-level tables, command lines, and security fields are not implemented in this vertical slice."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationCardTemplate" x:DataType="vm:ApplicationCardViewModel">
            <Border
                Padding="14"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="Transparent"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                Style="{StaticResource CardIdentityStyle}"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource CardSupportingTextStyle}"
                                Text="{x:Bind Publisher, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource CardSupportingTextStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                MinWidth="132"
                                Style="{StaticResource CardPrimaryMetricPanelStyle}"
                                ToolTipService.ToolTip="{x:Bind CpuStatusText, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="CPU" />
                                    <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind CpuText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind CpuStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                MinWidth="154"
                                Style="{StaticResource CardPrimaryMetricPanelStyle}"
                                ToolTipService.ToolTip="{x:Bind MemoryStatusText, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Memory" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CardSupportingTextStyle}"
                                            Text="{x:Bind ProcessCountText, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind MemoryText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind MemoryStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Margin="0,0,16,0"
                                Spacing="4"
                                ToolTipService.ToolTip="{x:Bind IoStatusText, Mode=OneWay}">
                                <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Process I/O" />
                                <TextBlock
                                    Style="{StaticResource CardMetricValueStyle}"
                                    Text="{x:Bind IoText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind IoStatusText, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Padding="16,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind PhysicalDiskStatusText, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Physical disk" />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind PhysicalDiskText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind PhysicalDiskStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="16,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind NetworkStatusText, Mode=OneWay}">
                                    <TextBlock
                                        Style="{StaticResource CardMetricLabelStyle}"
                                        Text="Network"
                                        ToolTipService.ToolTip="Send and receive packet bytes observed through kernel Network ETW. No payloads or destinations are collected." />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind NetworkText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind NetworkStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="3"
                                Padding="16,0,0,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind GpuStatusText, Mode=OneWay}">
                                    <TextBlock
                                        Style="{StaticResource CardMetricLabelStyle}"
                                        Text="GPU"
                                        ToolTipService.ToolTip="Busiest GPU engine across the application. Dedicated and shared memory are sums of Windows per-process GPU counters." />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind GpuText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource CardSupportingTextStyle}"
                                        Text="{x:Bind GpuStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationSectionTemplate" x:DataType="vm:ApplicationSectionViewModel">
            <StackPanel Margin="0,16,0,8" Spacing="4">
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{x:Bind Title, Mode=OneTime}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Bind Description, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <local:ApplicationListTemplateSelector
            x:Key="ApplicationListTemplateSelector"
            ApplicationTemplate="{StaticResource ApplicationCardTemplate}"
            SectionTemplate="{StaticResource ApplicationSectionTemplate}" />

        <Style x:Key="ApplicationCardListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="122" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="ApplicationSectionListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource ShellBrush}">
            <TitleBar
                x:Name="AppTitleBar"
                AutoRefreshDragRegions="True"
                Background="{StaticResource ShellBrush}"
                Title="Monitoring XS">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarIconMaxWidth">24</x:Double>
                    <x:Double x:Key="TitleBarIconMaxHeight">24</x:Double>
                    <Thickness x:Key="TitleBarIconMargin">0,0,10,0</Thickness>
                </TitleBar.Resources>
            </TitleBar>
            <Border
                VerticalAlignment="Bottom"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1" />
        </Grid>
        <Grid Grid.Row="1">
            <NavigationView
                x:Name="PrimaryNavigation"
                Background="{StaticResource ShellBrush}"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="LeftCompact"
                PaneTitle="Monitoring XS"
                SelectionChanged="PrimaryNavigation_SelectionChanged">
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="NavigationViewItemBorderBrushSelected" ResourceKey="SubtleBorderBrush" />
                <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="PriorityAccentBrush" />
                <x:Double x:Key="NavigationViewSelectionIndicatorWidth">4</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" IsEnabled="False" Tag="dashboard" ToolTipService.ToolTip="Dashboard" />
                <NavigationViewItem
                    x:Name="RunningNavigationItem"
                    Content="Running Apps"
                    FontWeight="SemiBold"
                    Icon="AllApps"
                    IsSelected="True"
                    Tag="running"
                    ToolTipService.ToolTip="Running Apps"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem Content="Portable Apps" Icon="OpenFile" IsEnabled="False" Tag="portable" ToolTipService.ToolTip="Portable Apps" />
                <NavigationViewItem
                    x:Name="HistoryNavigationItem"
                    Content="History"
                    Icon="Clock"
                    Tag="history"
                    ToolTipService.ToolTip="History"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    Content="Settings"
                    Icon="Setting"
                    Tag="settings"
                    ToolTipService.ToolTip="Settings"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem Content="About" Icon="Help" IsEnabled="False" Tag="about" ToolTipService.ToolTip="About" />
            </NavigationView.MenuItems>
            <Grid>
            <TabView
                x:Name="WorkspaceTabs"
                Background="{StaticResource PageBrush}"
                IsAddTabButtonVisible="False"
                TabCloseRequested="WorkspaceTabs_TabCloseRequested">
                <TabViewItem Header="Running Apps" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            MaxWidth="1320"
                            Margin="24,16,24,12"
                            HorizontalAlignment="Stretch"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="Running applications" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Row="1"
                                Padding="12"
                                Background="{StaticResource ToolbarBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid
                                    x:Name="ToolbarLayout"
                                    ColumnSpacing="12"
                                    RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        x:Name="ToolbarSortGroup"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Variable"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Sort by" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="180"
                                            Height="36"
                                            AutomationProperties.Name="Sort applications by"
                                            CornerRadius="6"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneTime}"
                                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Height="36"
                                            MinWidth="132"
                                            Padding="12,0"
                                            AutomationProperties.Name="{x:Bind ViewModel.SortDirectionAutomationName, Mode=OneWay}"
                                            Click="SortDirection_Click"
                                            Content="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="NoComparableDataText"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Polite"
                                        DataContext="{x:Bind ViewModel, Mode=OneTime}"
                                        FontFamily="Segoe UI Variable"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="No comparable data"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="All values are unavailable. Applications are ordered by name."
                                        Visibility="{Binding HasNoComparableData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <StackPanel
                                        x:Name="ToolbarAdvancedGroup"
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Variable"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            Text="Advanced" />
                                        <ToggleSwitch
                                            Height="36"
                                            AutomationProperties.Name="Show advanced application information"
                                            IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="AdvancedMode_Toggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            MaxWidth="1320"
                            Margin="24,0,24,24"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Running applications"
                            ContainerContentChanging="ApplicationList_ContainerContentChanging"
                            IsItemClickEnabled="True"
                            ItemClick="ApplicationList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.ApplicationItems, Mode=OneWay}"
                            ItemTemplateSelector="{StaticResource ApplicationListTemplateSelector}"
                            SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.Resources>
                                <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            </ListView.Resources>
                            <ListView.Header>
                                <Border
                                    x:Name="AdvancedModeNotice"
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource PriorityAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Advanced mode is on. Open an application tab and expand Advanced application information for attribution evidence and implementation availability."
                                        TextWrapping="Wrap" />
                                </Border>
                            </ListView.Header>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
            <local:HistoryPage
                x:Name="HistoryWorkspace"
                Visibility="Collapsed" />
            <local:SettingsPage
                x:Name="SettingsWorkspace"
                Visibility="Collapsed" />
            </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>

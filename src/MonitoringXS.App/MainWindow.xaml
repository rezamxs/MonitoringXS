<Window
    x:Class="MonitoringXS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    xmlns:local="using:MonitoringXS.App"
    xmlns:vm="using:MonitoringXS.App.ViewModels"
    Title="Monitoring XS">
    <Grid x:Name="Root" Background="{StaticResource PageBrush}">
        <Grid.Resources>
        <DataTemplate x:Key="ApplicationDetailTemplate">
            <ScrollViewer>
                <StackPanel Padding="24" Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource SectionTitleStyle}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding ProcessSummary}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding CpuText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Working set" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding MemoryText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O read" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoReadText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="3"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O write" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding IoWriteText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Physical disk (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Physical disk read rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Read" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskReadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Physical disk write rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Write" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding PhysicalDiskWriteText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding PhysicalDiskStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network (ETW)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Network download rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Download" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkDownloadText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Network upload rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Upload" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding NetworkUploadText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding NetworkStatusText}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="CPU · last minute" />
                        <controls:MetricSparkline
                            AutomationProperties.Name="CPU history for the selected application"
                            Samples="{Binding CpuSamples}" />
                    </StackPanel>
                    <Expander Header="Advanced application information">
                        <StackPanel Padding="0,12,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Classification evidence" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationConfidence}" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationReason}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Physical-disk session totals" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskOperationsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Network session details" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkEndpointsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="Process-level tables, command lines, GPU, and security fields are not implemented in this vertical slice."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationCardTemplate" x:DataType="vm:ApplicationCardViewModel">
            <Border
                Padding="16"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="Transparent"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.55*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            Style="{StaticResource CardIdentityStyle}"
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource CardSupportingTextStyle}"
                            Text="{x:Bind Publisher, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource CardSupportingTextStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="CPU" />
                        <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind CpuText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Memory" />
                        <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CardSupportingTextStyle}"
                            Text="{x:Bind ProcessCountText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Process I/O" />
                        <TextBlock
                            Style="{StaticResource CardMetricValueStyle}"
                            Text="{x:Bind IoText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Physical disk (ETW)" />
                        <TextBlock
                            Style="{StaticResource CardMetricValueStyle}"
                            Text="{x:Bind PhysicalDiskText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource CardMetricLabelStyle}" Text="Network" />
                        <TextBlock
                            Style="{StaticResource CardMetricValueStyle}"
                            Text="{x:Bind NetworkText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource CardSupportingTextStyle}"
                            Text="{x:Bind NetworkStatusText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationSectionTemplate" x:DataType="vm:ApplicationSectionViewModel">
            <StackPanel Margin="0,16,0,8" Spacing="4">
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{x:Bind Title, Mode=OneTime}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Bind Description, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <local:ApplicationListTemplateSelector
            x:Key="ApplicationListTemplateSelector"
            ApplicationTemplate="{StaticResource ApplicationCardTemplate}"
            SectionTemplate="{StaticResource ApplicationSectionTemplate}" />

        <Style x:Key="ApplicationCardListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="98" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="ApplicationSectionListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Background="{StaticResource PageBrush}"
            Subtitle="Logical application monitor"
            Title="Monitoring XS" />
        <Grid Grid.Row="1">
            <NavigationView
                x:Name="PrimaryNavigation"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="LeftCompact"
                PaneTitle="Monitoring XS">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" IsEnabled="False" Tag="dashboard" />
                <NavigationViewItem Content="Running Apps" Icon="AllApps" IsSelected="True" Tag="running" />
                <NavigationViewItem Content="Portable Apps" Icon="OpenFile" IsEnabled="False" Tag="portable" />
                <NavigationViewItem Content="History" Icon="Clock" IsEnabled="False" Tag="history" />
                <NavigationViewItem Content="Settings" Icon="Setting" IsEnabled="False" Tag="settings" />
                <NavigationViewItem Content="About" Icon="Help" IsEnabled="False" Tag="about" />
            </NavigationView.MenuItems>
            <TabView
                x:Name="WorkspaceTabs"
                IsAddTabButtonVisible="False"
                TabCloseRequested="WorkspaceTabs_TabCloseRequested">
                <TabViewItem Header="Running Apps" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="24,18,24,14" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="Running applications" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="Sort" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="172"
                                    AutomationProperties.Name="Sort applications by"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneTime}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    MinWidth="116"
                                    AutomationProperties.Name="{x:Bind ViewModel.SortDirectionAutomationName, Mode=OneWay}"
                                    Click="SortDirection_Click"
                                    Content="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}"
                                    ToolTipService.ToolTip="Change sort direction" />
                                <ToggleSwitch
                                    Grid.Column="3"
                                    AutomationProperties.Name="Show advanced application information"
                                    Header="Advanced mode"
                                    IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                    Toggled="AdvancedMode_Toggled" />
                            </Grid>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            Margin="24,0,24,24"
                            AutomationProperties.Name="Running applications"
                            ContainerContentChanging="ApplicationList_ContainerContentChanging"
                            IsItemClickEnabled="True"
                            ItemClick="ApplicationList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.ApplicationItems, Mode=OneWay}"
                            ItemTemplateSelector="{StaticResource ApplicationListTemplateSelector}"
                            SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.Resources>
                                <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            </ListView.Resources>
                            <ListView.Header>
                                <Border
                                    x:Name="AdvancedModeNotice"
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource PriorityAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Advanced mode is on. Open an application tab and expand Advanced application information for attribution evidence and implementation availability."
                                        TextWrapping="Wrap" />
                                </Border>
                            </ListView.Header>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
            </NavigationView>
        </Grid>
    </Grid>
</Window>

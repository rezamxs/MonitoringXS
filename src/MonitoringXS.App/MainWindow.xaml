<Window
    x:Class="MonitoringXS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    xmlns:local="using:MonitoringXS.App"
    xmlns:vm="using:MonitoringXS.App.ViewModels"
    Title="Monitoring XS">
    <Grid
        x:Name="Root"
        Background="{StaticResource PageBrush}">
        <Grid.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="ApplicationTabHeaderTemplate">
            <Grid
                AutomationProperties.Name="{Binding Title}"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="24"
                    Height="24">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Glyph="&#xE71D;"
                        Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="20"
                        Height="20"
                        Source="{Binding AppIconSource}"
                        Stretch="Uniform"
                        Visibility="{Binding HasAppIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    MaxWidth="220"
                    VerticalAlignment="Center"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MetricExplanationTemplate" x:DataType="vm:MetricExplanationViewModel">
            <Border
                Margin="0,0,0,4"
                Padding="10,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{x:Bind BeginnerText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasVisibleStatus, Mode=OneWay}" />
                    <Expander
                        x:Uid="MetricAdvancedDetails"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <StackPanel Padding="0,8,0,0" Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{x:Bind AdvancedText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Uid="MetricProviderLabel" FontWeight="SemiBold" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{x:Bind ProviderName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ApplicationDetailTemplate">
            <ScrollViewer x:Name="ApplicationDetailRoot" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1800" Padding="24" HorizontalAlignment="Stretch" Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="44"
                            Height="44"
                            AutomationProperties.Name="{Binding Title}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Glyph="&#xE71D;"
                                Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="32"
                                Height="32"
                                Source="{Binding AppIconSource}"
                                Stretch="Uniform"
                                Visibility="{Binding HasAppIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ProcessSummary}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="DetailMetricGrid" ColumnSpacing="12" RowSpacing="12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="CompactDetailMetrics" />
                                <VisualState x:Name="WideDetailMetrics">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1000" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DetailIoReadCard.(Grid.Row)" Value="0" />
                                        <Setter Target="DetailIoReadCard.(Grid.Column)" Value="2" />
                                        <Setter Target="DetailIoWriteCard.(Grid.Row)" Value="0" />
                                        <Setter Target="DetailIoWriteCard.(Grid.Column)" Value="3" />
                                        <Setter Target="DetailMetricColumnThree.Width" Value="*" />
                                        <Setter Target="DetailMetricColumnFour.Width" Value="*" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="DetailMetricColumnThree" Width="0" />
                            <ColumnDefinition x:Name="DetailMetricColumnFour" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE9F5;" Foreground="{StaticResource DataAccentBrush}" />
                                    <TextBlock x:Uid="MetricCpuLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                                </Grid>
                                <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="24" Text="{Binding CpuText}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CpuStatusText}" TextWrapping="Wrap" />
                                <controls:MetricSparkline
                                    x:Uid="MetricCpuSparkline"
                                    Height="48"
                                    ChartScale="Percent"
                                    IsEmbedded="True"
                                    ShowSummary="False"
                                    Samples="{Binding CpuSamples}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE950;" Foreground="{StaticResource DataAccentBrush}" />
                                    <TextBlock x:Uid="MetricMemoryLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Working set" />
                                </Grid>
                                <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="24" Text="{Binding MemoryText}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding MemoryStatusText}" TextWrapping="Wrap" />
                                <controls:MetricSparkline
                                    x:Uid="MetricMemorySparkline"
                                    Height="48"
                                    ChartScale="Dynamic"
                                    IsEmbedded="True"
                                    ShowSummary="False"
                                    Samples="{Binding MemorySamples}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DetailIoReadCard"
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8B6;" Foreground="{StaticResource DataAccentBrush}" />
                                    <TextBlock x:Uid="MetricIoReadLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O read" />
                                </Grid>
                                <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="24" Text="{Binding IoReadText}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding IoStatusText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DetailIoWriteCard"
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE74E;" Foreground="{StaticResource DataAccentBrush}" />
                                    <TextBlock x:Uid="MetricIoWriteLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Process I/O write" />
                                </Grid>
                                <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="24" Text="{Binding IoWriteText}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding IoStatusText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xEDA2;" Foreground="{StaticResource DataAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="MetricDiskTitle" Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="Physical disk" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Physical disk read rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE8B6;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricReadLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Read" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding PhysicalDiskReadText}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding PhysicalDiskStatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Physical disk write rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricWriteLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Write" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding PhysicalDiskWriteText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE968;" Foreground="{StaticResource DataAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="MetricNetworkTitle" Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="Network" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="Network download and receive rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE704;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricReceiveLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Download / Receive" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding NetworkDownloadText}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding NetworkStatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Network upload and send rate"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE705;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricSendLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Upload / Send" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding NetworkUploadText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE943;" Foreground="{StaticResource DataAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="MetricGpuTitle" Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="GPU" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="16"
                                AutomationProperties.Name="GPU utilization"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE9F5;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricBusiestEngineLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Busiest engine" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding GpuUsageText}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding GpuStatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                AutomationProperties.Name="Dedicated GPU memory reported for application processes"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE950;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricDedicatedLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Dedicated memory" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding DedicatedGpuMemoryText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="16"
                                AutomationProperties.Name="Shared GPU memory reported for application processes"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE774;" Foreground="{StaticResource DataAccentBrush}" />
                                        <TextBlock x:Uid="MetricSharedLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Shared memory" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MetricValueStyle}" FontSize="22" Text="{Binding SharedGpuMemoryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Expander x:Uid="MetricExplanations">
                        <ItemsControl
                            Margin="0,12,0,0"
                            ItemTemplate="{StaticResource MetricExplanationTemplate}"
                            ItemsSource="{Binding MetricExplanations, Mode=OneWay}" />
                    </Expander>
                    <Expander x:Uid="AdvancedInfo" Header="Advanced application information">
                        <StackPanel Padding="0,12,0,0" Spacing="8">
                            <TextBlock x:Uid="ClassificationEvidence" FontWeight="SemiBold" Text="Classification evidence" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationConfidence}" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding ClassificationReason}"
                                TextWrapping="Wrap" />
                                <TextBlock x:Uid="DiskTotals" FontWeight="SemiBold" Text="Physical-disk session totals" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskOperationsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PhysicalDiskDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Uid="NetworkDetails" FontWeight="SemiBold" Text="Network session details" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkTotalsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkEndpointsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding NetworkDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Uid="GpuDetails" FontWeight="SemiBold" Text="GPU counter details" />
                            <TextBlock x:Uid="UnavailableImplementation"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding GpuDiagnosticsText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="Process-level tables, command lines, and security fields are not implemented in this vertical slice."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <Border
                        Style="{StaticResource SectionSurfaceStyle}"
                        DataContext="{Binding ProcessActions}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="ProcessDetailsTitle"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Process details and actions" />
                                <TextBlock x:Uid="ProcessDetailsDescription"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="Actions remain non-elevated and revalidate PID, start time, and executable identity."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid MaxWidth="460" HorizontalAlignment="Stretch" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="32"
                                    Height="32">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Glyph="&#xE71D;"
                                        Visibility="{Binding DataContext.HasFallbackIcon, ElementName=ApplicationDetailRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="28"
                                        Height="28"
                                        Source="{Binding DataContext.AppIconSource, ElementName=ApplicationDetailRoot}"
                                        Stretch="Uniform"
                                        Visibility="{Binding DataContext.HasAppIcon, ElementName=ApplicationDetailRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <ComboBox x:Uid="ProcessSelector"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Process for application actions"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding Processes, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                    UseSystemFocusVisuals="True" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    FlowDirection="LeftToRight"
                                    Text="{Binding IdentityText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FlowDirection="LeftToRight"
                                    Text="{Binding StartTimeText, Mode=OneWay}" />
                                <TextBlock x:Uid="ProcessPath"
                                    AutomationProperties.Name="Selected process executable path"
                                    FlowDirection="LeftToRight"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding ExecutablePathText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{Binding ExecutablePathText, Mode=OneWay}" />
                            </StackPanel>
                            <Expander x:Uid="ProcessDetailsAdvanced" HorizontalAlignment="Stretch">
                                <TextBlock
                                    AutomationProperties.Name="Selected process metadata"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding ProcessDetailsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Expander>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="EndTaskButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Ends only the selected process after confirmation and identity revalidation."
                                    AutomationProperties.Name="End selected task"
                                    Command="{Binding EndTaskCommand}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    UseSystemFocusVisuals="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Stop" />
                                        <TextBlock x:Uid="EndTaskButtonLabel" Text="End Task" />
                                    </StackPanel>
                                </Button>
                                <Button x:Uid="EndTreeButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Ends verified descendants from leaves to root after stronger confirmation."
                                    AutomationProperties.Name="End selected process tree"
                                    Command="{Binding EndProcessTreeCommand}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    UseSystemFocusVisuals="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Delete" />
                                        <TextBlock x:Uid="EndTreeButtonLabel" Text="End Process Tree" />
                                    </StackPanel>
                                </Button>
                                <Button x:Uid="OpenLocationButton"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Opens Explorer and selects the verified executable."
                                    AutomationProperties.Name="Open selected process file location"
                                    Command="{Binding OpenFileLocationCommand}"
                                    UseSystemFocusVisuals="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="OpenFile" />
                                        <TextBlock x:Uid="OpenLocationButtonLabel" Text="Open File Location" />
                                    </StackPanel>
                                </Button>
                                <Button x:Uid="CopyDetailsButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Copies safe process identity and current application metrics without command lines or secrets."
                                    AutomationProperties.Name="Copy selected process details"
                                    Command="{Binding CopyProcessDetailsCommand}"
                                    UseSystemFocusVisuals="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Copy" />
                                        <TextBlock x:Uid="CopyDetailsButtonLabel" Text="Copy Process Details" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock
                                AutomationProperties.LiveSetting="Assertive"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding StatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationCardTemplate" x:DataType="vm:ApplicationCardViewModel">
            <Border
                Padding="14"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Margin="0,4,12,4"
                            VerticalAlignment="Center"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="40"
                                Height="40">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Glyph="&#xE71D;"
                                    Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="32"
                                    Height="32"
                                    Source="{x:Bind AppIconSource, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Visibility="{Binding HasAppIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CardIdentityStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CardSupportingTextStyle}"
                                    Text="{x:Bind Publisher, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource CardSupportingTextStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                MinWidth="132"
                                Style="{StaticResource CardPrimaryMetricPanelStyle}"
                                ToolTipService.ToolTip="{x:Bind CpuStatusText, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Uid="CardCpuLabel" Style="{StaticResource CardMetricLabelStyle}" Text="CPU" />
                                    <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind CpuText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind CpuStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                MinWidth="154"
                                Style="{StaticResource CardPrimaryMetricPanelStyle}"
                                ToolTipService.ToolTip="{x:Bind MemoryStatusText, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="CardMemoryLabel" Style="{StaticResource CardMetricLabelStyle}" Text="Memory" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CardSupportingTextStyle}"
                                            Text="{x:Bind ProcessCountText, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource CardPrimaryMetricValueStyle}" Text="{x:Bind MemoryText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind MemoryStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Margin="0,0,16,0"
                                Spacing="4"
                                ToolTipService.ToolTip="{x:Bind IoStatusText, Mode=OneWay}">
                                <TextBlock x:Uid="CardIoLabel" Style="{StaticResource CardMetricLabelStyle}" Text="Process I/O" />
                                <TextBlock
                                    Style="{StaticResource CardMetricValueStyle}"
                                    Text="{x:Bind IoText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind IoStatusText, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Padding="16,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind PhysicalDiskStatusText, Mode=OneWay}">
                                    <TextBlock x:Uid="CardDiskLabel" Style="{StaticResource CardMetricLabelStyle}" Text="Physical disk" />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind PhysicalDiskText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind PhysicalDiskStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="16,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind NetworkStatusText, Mode=OneWay}">
                                    <TextBlock x:Uid="CardNetworkLabel"
                                        Style="{StaticResource CardMetricLabelStyle}" />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind NetworkText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CardSupportingTextStyle}" Text="{x:Bind NetworkStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="3"
                                Padding="16,0,0,0"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <StackPanel
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind GpuStatusText, Mode=OneWay}">
                                    <TextBlock x:Uid="CardGpuLabel"
                                        Style="{StaticResource CardMetricLabelStyle}" />
                                    <TextBlock
                                        Style="{StaticResource CardMetricValueStyle}"
                                        Text="{x:Bind GpuText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource CardSupportingTextStyle}"
                                        Text="{x:Bind GpuStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationSectionTemplate" x:DataType="vm:ApplicationSectionViewModel">
            <StackPanel Margin="0,16,0,8" Spacing="4">
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{x:Bind Title, Mode=OneTime}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{x:Bind Description, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <local:ApplicationListTemplateSelector
            x:Key="ApplicationListTemplateSelector"
            ApplicationTemplate="{StaticResource ApplicationCardTemplate}"
            SectionTemplate="{StaticResource ApplicationSectionTemplate}" />

        <Style x:Key="ApplicationCardListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="122" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="ApplicationSectionListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource ShellBrush}">
            <TitleBar
                x:Name="AppTitleBar"
                AutoRefreshDragRegions="True"
                Background="{StaticResource ShellBrush}"
                Title="Monitoring XS">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarIconMaxWidth">24</x:Double>
                    <x:Double x:Key="TitleBarIconMaxHeight">24</x:Double>
                    <Thickness x:Key="TitleBarIconMargin">0,0,10,0</Thickness>
                </TitleBar.Resources>
            </TitleBar>
            <Border
                VerticalAlignment="Bottom"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1" />
        </Grid>
        <Grid Grid.Row="1">
            <NavigationView
                x:Name="PrimaryNavigation"
                Background="{StaticResource ShellBrush}"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                CompactPaneLength="52"
                OpenPaneLength="220"
                PaneDisplayMode="Auto"
                PaneTitle="Monitoring XS"
                SelectionChanged="PrimaryNavigation_SelectionChanged">
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="NavigationViewItemBorderBrushSelected" ResourceKey="SubtleBorderBrush" />
                <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="PriorityAccentBrush" />
                <x:Double x:Key="NavigationViewSelectionIndicatorWidth">4</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDashboard" Icon="Home" IsEnabled="False" Tag="dashboard" />
                <NavigationViewItem x:Uid="NavRunning"
                    x:Name="RunningNavigationItem"
                    Icon="AllApps"
                    IsSelected="True"
                    Tag="running"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem x:Uid="NavSystemOverview"
                    x:Name="SystemOverviewNavigationItem"
                    Icon="ViewAll"
                    Tag="system-overview"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem x:Uid="NavPortable" Icon="OpenFile" IsEnabled="False" Tag="portable" />
                <NavigationViewItem x:Uid="NavHistory"
                    x:Name="HistoryNavigationItem"
                    Icon="Clock"
                    Tag="history"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem x:Uid="NavDiagnostics"
                    x:Name="DiagnosticsNavigationItem"
                    Icon="Repair"
                    Tag="diagnostics"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem x:Uid="NavSettings"
                    x:Name="SettingsNavigationItem"
                    Icon="Setting"
                    Tag="settings"
                    UseSystemFocusVisuals="True" />
                <NavigationViewItem x:Uid="NavAbout"
                    x:Name="AboutNavigationItem"
                    Icon="Help"
                    Tag="about"
                    UseSystemFocusVisuals="True" />
            </NavigationView.MenuItems>
            <Grid>
            <TabView
                x:Name="WorkspaceTabs"
                Background="{StaticResource PageBrush}"
                IsAddTabButtonVisible="False"
                TabCloseRequested="WorkspaceTabs_TabCloseRequested">
                <TabViewItem x:Uid="RunningAppsTab" Header="Running Apps" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            MaxWidth="1800"
                            Margin="24,16,24,12"
                            HorizontalAlignment="Stretch"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="AllApps" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource PageTitleStyle}"
                                        x:Uid="RunningAppsTitle"
                                        Text="Running applications" />
                                </Grid>
                                <TextBlock
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Row="1"
                                Padding="12"
                                Background="{StaticResource ToolbarBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid
                                    x:Name="ToolbarLayout"
                                    ColumnSpacing="12"
                                    RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        x:Name="ToolbarSortGroup"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Variable"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            x:Uid="SortBy"
                                            Text="Sort by" />
                                        <ComboBox x:Uid="SortSelector"
                                            Grid.Column="1"
                                            Width="180"
                                            Height="36"
                                            AutomationProperties.Name="Sort applications by"
                                            CornerRadius="6"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneTime}"
                                            SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Height="36"
                                            MinWidth="132"
                                            Padding="12,0"
                                            AutomationProperties.Name="{x:Bind ViewModel.SortDirectionAutomationName, Mode=OneWay}"
                                            Click="SortDirection_Click"
                                            Content="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}" />
                                    </Grid>

                                    <Grid
                                        x:Name="ApplicationSearchGroup"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Uid="ApplicationSearchBox"
                                            x:Name="ApplicationSearchBox"
                                            Height="36"
                                            Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                                            TextChanged="ApplicationSearchBox_TextChanged"
                                            UseSystemFocusVisuals="True" />
                                        <Button x:Uid="ClearApplicationSearchButton"
                                            Grid.Column="1"
                                            Height="36"
                                            Click="ClearApplicationSearchButton_Click"
                                            UseSystemFocusVisuals="True" />
                                    </Grid>

                                    <TextBlock x:Uid="NoComparableData"
                                        x:Name="NoComparableDataText"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Polite"
                                        DataContext="{x:Bind ViewModel, Mode=OneTime}"
                                        FontFamily="Segoe UI Variable"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasNoComparableData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <StackPanel
                                        x:Name="ToolbarAdvancedGroup"
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Variable"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            x:Uid="AdvancedToggle"
                                            Text="Advanced" />
                                        <ToggleSwitch x:Uid="AdvancedSwitch"
                                            Height="36"
                                            AutomationProperties.Name="Show advanced application information"
                                            IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="AdvancedMode_Toggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ListView x:Uid="RunningApplicationsList"
                            Grid.Row="1"
                            MaxWidth="1800"
                            Margin="24,0,24,24"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Running applications"
                            ContainerContentChanging="ApplicationList_ContainerContentChanging"
                            IsItemClickEnabled="True"
                            ItemClick="ApplicationList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.ApplicationItems, Mode=OneWay}"
                            ItemTemplateSelector="{StaticResource ApplicationListTemplateSelector}"
                            SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.Resources>
                                <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            </ListView.Resources>
                            <ListView.Header>
                                <StackPanel DataContext="{x:Bind ViewModel, Mode=OneTime}">
                                    <Border
                                        x:Name="AdvancedModeNotice"
                                        Margin="0,0,0,8"
                                        Padding="14"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource PriorityAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <TextBlock x:Uid="AdvancedNotice"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            Text="Advanced mode is on. Open an application tab and expand Advanced application information for attribution evidence and implementation availability."
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasNoSearchResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock x:Uid="NoSearchResults"
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ListView.Header>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
            <local:SystemOverviewPage
                x:Name="SystemOverviewWorkspace"
                DataContext="{x:Bind ViewModel.SystemOverview, Mode=OneTime}"
                Visibility="Collapsed" />
            <local:HistoryPage
                x:Name="HistoryWorkspace"
                Visibility="Collapsed" />
            <local:DiagnosticsPage
                x:Name="DiagnosticsWorkspace"
                Visibility="Collapsed" />
            <local:SettingsPage
                x:Name="SettingsWorkspace"
                Visibility="Collapsed" />
            <local:AboutPage
                x:Name="AboutWorkspace"
                Visibility="Collapsed" />
            </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MonitoringXS.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\MonitoringXS.ico</ApplicationIcon>
    <!-- Self-contained Windows App SDK builds require a concrete native architecture. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\Branding\*.ico" />
    <None Remove="Assets\Branding\*.png" />
    <Content Include="Assets\Branding\MonitoringXS.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Branding\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonitoringXS.Application\MonitoringXS.Application.csproj" />
    <ProjectReference Include="..\MonitoringXS.Collectors\MonitoringXS.Collectors.csproj" />
    <ProjectReference Include="..\MonitoringXS.Core\MonitoringXS.Core.csproj" />
    <ProjectReference Include="..\MonitoringXS.DesignSystem\MonitoringXS.DesignSystem.csproj" />
    <ProjectReference Include="..\MonitoringXS.Platform.Windows\MonitoringXS.Platform.Windows.csproj" />
    <ProjectReference Include="..\MonitoringXS.Storage\MonitoringXS.Storage.csproj" />
  </ItemGroup>
  <Target Name="CopyAppPriToSelfContainedPublish"
          AfterTargets="Publish"
          Condition="'$(SelfContained)' == 'true' and '$(WindowsAppSDKSelfContained)' == 'true' and Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)" />
  </Target>
</Project>

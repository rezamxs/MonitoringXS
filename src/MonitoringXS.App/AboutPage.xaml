<UserControl
    x:Class="MonitoringXS.App.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AboutRoot" Background="{StaticResource PageBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboutSecondaryColumn.Width" Value="*" />
                        <Setter Target="BetaLimitationsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="BetaLimitationsPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            Padding="24,16,24,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Spacing="16">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Help" />
                        <TextBlock x:Name="ProductTitle"
                            Grid.Column="1"
                            Style="{StaticResource PageTitleStyle}"
                            Text="Monitoring XS" />
                        <Border Grid.Column="2"
                            Padding="9,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource PriorityAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock x:Name="BetaBadge"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PriorityAccentBrush}"
                                Text="Public Beta" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="VersionText"
                        FlowDirection="LeftToRight"
                        Style="{StaticResource CardSupportingTextStyle}"
                        Text="0.9.0-beta.1" />
                    <TextBlock x:Name="DescriptionText"
                        MaxWidth="760"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Border Style="{StaticResource SectionSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PlatformLabel"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="OpenSourceLabel"
                                Style="{StaticResource CardSupportingTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource SubtleBorderBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PrivacySummary"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="PrivacyDetail"
                                Style="{StaticResource CardSupportingTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource SubtleBorderBrush}" />
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="RepositoryLabel" FontWeight="SemiBold" />
                                <HyperlinkButton x:Name="RepositoryLink"
                                    Padding="0"
                                    FlowDirection="LeftToRight"
                                    NavigateUri="https://github.com/rezamxs/MonitoringXS"
                                    UseSystemFocusVisuals="True" />
                            </StackPanel>
                            <TextBlock x:Name="LicenseLabel" Style="{StaticResource CardSupportingTextStyle}" />
                            <TextBlock x:Name="CopyrightLabel"
                                FlowDirection="LeftToRight"
                                Style="{StaticResource CardSupportingTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AboutSecondaryColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="WhatsNewPanel" Style="{StaticResource SectionSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="WhatsNewTitle" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="WhatsNewList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Margin="0,4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="5" Height="5"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource DataAccentBrush}"
                                                CornerRadius="3" />
                                            <TextBlock Grid.Column="1"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BetaLimitationsPanel"
                        Grid.Row="1"
                        Style="{StaticResource SectionSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="BetaLimitationsTitle" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="BetaLimitationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Margin="0,4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="5" Height="5"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource WarningBrush}"
                                                CornerRadius="3" />
                                            <TextBlock Grid.Column="1"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

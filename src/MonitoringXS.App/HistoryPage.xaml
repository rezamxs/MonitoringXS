<UserControl
    x:Class="MonitoringXS.App.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    AutomationProperties.Name="Application metric history page"
    IsTabStop="False">
    <Grid
        Padding="24,16,24,24"
        Background="{StaticResource PageBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="History" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Saved application metrics · local SQLite history" />
            </StackPanel>
            <ProgressRing
                Grid.Column="1"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading application history"
                IsActive="{Binding IsLoading, Mode=OneWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            Padding="12"
            Background="{StaticResource ToolbarBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox
                    x:Name="ApplicationSelector"
                    Width="280"
                    AutomationProperties.Name="History application"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding Applications}"
                    SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                    SelectionChanged="ApplicationSelector_SelectionChanged"
                    UseSystemFocusVisuals="True" />
                <ComboBox
                    x:Name="RangeSelector"
                    Width="160"
                    AutomationProperties.Name="History time range"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding Ranges}"
                    SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                    SelectionChanged="RangeSelector_SelectionChanged"
                    UseSystemFocusVisuals="True" />
                <Button
                    AutomationProperties.Name="Refresh application history"
                    Click="Refresh_Click"
                    Content="Refresh"
                    UseSystemFocusVisuals="True" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="{Binding StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding SelectedRangeText, Mode=OneWay}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding LastUpdatedText, Mode=OneWay}" />
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding QueryPerformanceText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="3"
            AutomationProperties.Name="History metric charts"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding Charts}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="12"
                        MinItemHeight="230"
                        MinItemWidth="400"
                        MinRowSpacing="12"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,12,12"
                            Padding="14"
                            AutomationProperties.Name="{Binding AccessibilityText, Mode=OneWay}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            Style="{StaticResource SectionTitleStyle}"
                                            Text="{Binding Title, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="{Binding UnitText, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Line = measured; gap = unavailable/partial" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="{Binding StateText, Mode=OneWay}" />
                                </Grid>
                                <controls:MetricSparkline
                                    Grid.Row="1"
                                    Height="180"
                                    AutomationProperties.Name="{Binding AccessibilityText, Mode=OneWay}"
                                    EmptyText="{Binding StateText, Mode=OneWay}"
                                    IsTabStop="True"
                                    RangeEndUtc="{Binding RangeEndUtc, Mode=OneWay}"
                                    RangeStartUtc="{Binding RangeStartUtc, Mode=OneWay}"
                                    Samples="{Binding Samples, Mode=OneWay}"
                                    ChartScale="{Binding Scale, Mode=OneTime}"
                                    SummaryText="{Binding Summary, Mode=OneWay}"
                                    UnitText="{Binding UnitText, Mode=OneTime}"
                                    UseSystemFocusVisuals="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>

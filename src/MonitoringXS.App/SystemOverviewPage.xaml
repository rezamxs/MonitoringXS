<UserControl
    x:Class="MonitoringXS.App.SystemOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonitoringXS.App.Controls"
    xmlns:local="using:MonitoringXS.App">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />

        <Style x:Key="SystemOverviewStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="SummaryMetricTemplate">
            <!--
                Every summary card renders the same rows (a placeholder stands in
                for a missing secondary value) so UniformGridLayout, which sizes
                all items from the first one, never clips a taller card. Values
                never wrap: the Viewbox shrinks them to the card width instead.
            -->
            <Border
                Padding="14"
                AutomationProperties.HelpText="{Binding StatusText}"
                AutomationProperties.Name="{Binding Title}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ToolTipService.ToolTip="{Binding Explanation}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource DataAccentBrush}"
                            Glyph="{Binding IconGlyph}" />
                        <Viewbox
                            Grid.Column="1"
                            Height="20"
                            HorizontalAlignment="Left"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level3"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding Title}"
                                TextWrapping="NoWrap" />
                        </Viewbox>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WarningBrush}"
                            Text="{Binding StatusLabel}"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{Binding StatusText}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding PrimaryLabel}"
                        TextWrapping="NoWrap" />
                    <Viewbox
                        Height="30"
                        HorizontalAlignment="Left"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <TextBlock
                            FlowDirection="LeftToRight"
                            FontFamily="Cascadia Mono, Segoe UI Variable"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding PrimaryValue}"
                            TextWrapping="NoWrap" />
                    </Viewbox>
                    <Grid>
                        <Grid
                            ColumnSpacing="6"
                            Visibility="{Binding HasSecondaryValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding SecondaryLabel}"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Grid.Column="1"
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Segoe UI Variable"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding SecondaryValue}"
                                TextWrapping="NoWrap" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Text=" "
                            Visibility="{Binding HasSecondaryValue, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                    </Grid>
                    <controls:MetricSparkline
                        Height="52"
                        AutomationProperties.HelpText="{Binding ChartSummary}"
                        AutomationProperties.Name="{Binding PrimaryChartAutomationName}"
                        ChartScale="{Binding ChartScale}"
                        EmptyText="{Binding ChartEmptyText}"
                        IsEmbedded="True"
                        Samples="{Binding PrimarySamples}"
                        ShowSummary="False"
                        SummaryText="{Binding ChartSummary}"
                        UnitText="{Binding UnitText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PrimaryMetricTemplate">
            <Border
                Padding="18"
                AutomationProperties.HelpText="{Binding StatusText}"
                AutomationProperties.Name="{Binding Title}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ToolTipService.ToolTip="{Binding Explanation}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="18"
                            Foreground="{StaticResource DataAccentBrush}"
                            Glyph="{Binding IconGlyph}" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.HeadingLevel="Level3"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource SystemOverviewStatusStyle}"
                            Text="{Binding StatusLabel}"
                            ToolTipService.ToolTip="{Binding StatusText}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding PrimaryLabel}" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Segoe UI Variable"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding PrimaryValue}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="120"
                            Spacing="2"
                            Visibility="{Binding HasSecondaryValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding SecondaryLabel}" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Segoe UI Variable"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding SecondaryValue}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <controls:MetricSparkline
                        Height="64"
                        AutomationProperties.HelpText="{Binding ChartSummary}"
                        AutomationProperties.Name="{Binding PrimaryChartAutomationName}"
                        ChartScale="{Binding ChartScale}"
                        EmptyText="{Binding ChartEmptyText}"
                        IsEmbedded="True"
                        Samples="{Binding PrimarySamples}"
                        ShowSummary="False"
                        SummaryText="{Binding ChartSummary}"
                        UnitText="{Binding UnitText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActivityMetricTemplate">
            <!--
                One column per series: label, value and its chart together. The
                earlier layout listed the values and then repeated the same
                labels above the charts, which read as duplicated rows (its window-width
                trigger never fired inside a DataTemplate).
            -->
            <Border
                Padding="16"
                AutomationProperties.HelpText="{Binding StatusText}"
                AutomationProperties.Name="{Binding Title}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="17"
                            Foreground="{StaticResource DataAccentBrush}"
                            Glyph="{Binding IconGlyph}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level3"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource SystemOverviewStatusStyle}"
                            Text="{Binding StatusLabel}"
                            ToolTipService.ToolTip="{Binding StatusText}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="{Binding SeriesColumnSpan}" Spacing="4">
                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding PrimaryLabel}" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Segoe UI Variable"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding PrimaryValue}"
                                TextWrapping="Wrap" />
                            <controls:MetricSparkline
                                Height="56"
                                AutomationProperties.HelpText="{Binding ChartSummary}"
                                AutomationProperties.Name="{Binding PrimaryChartAutomationName}"
                                ChartScale="{Binding ChartScale}"
                                EmptyText="{Binding ChartEmptyText}"
                                IsEmbedded="True"
                                Samples="{Binding PrimarySamples}"
                                ShowSummary="False"
                                SummaryText="{Binding ChartSummary}"
                                UnitText="{Binding UnitText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            Visibility="{Binding HasSecondarySeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SecondaryLabel}" />
                            <TextBlock
                                FlowDirection="LeftToRight"
                                FontFamily="Cascadia Mono, Segoe UI Variable"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding SecondaryValue}"
                                TextWrapping="Wrap" />
                            <controls:MetricSparkline
                                Height="56"
                                AutomationProperties.HelpText="{Binding ChartSummary}"
                                AutomationProperties.Name="{Binding SecondaryChartAutomationName}"
                                ChartScale="{Binding ChartScale}"
                                EmptyText="{Binding ChartEmptyText}"
                                IsEmbedded="True"
                                Samples="{Binding SecondarySamples}"
                                ShowSummary="False"
                                SummaryText="{Binding ChartSummary}"
                                UnitText="{Binding UnitText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1800"
            Padding="24,20,24,32"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="ViewAll" />
                    <TextBlock
                        Grid.Column="1"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding PageTitle}" />
                </Grid>
                <TextBlock
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsRepeater ItemTemplate="{StaticResource SummaryMetricTemplate}" ItemsSource="{Binding SummaryCards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="5"
                        MinColumnSpacing="12"
                        MinItemWidth="205"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding PrimaryMetricsTitle}" />
            <ItemsRepeater ItemTemplate="{StaticResource PrimaryMetricTemplate}" ItemsSource="{Binding PrimaryCards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="2"
                        MinColumnSpacing="16"
                        MinItemWidth="440"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <StackPanel Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding SecondaryMetricsTitle}" />
                <TextBlock
                    AutomationProperties.HelpText="{Binding ChartHelpText}"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding ChartHelpText}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ItemsRepeater ItemTemplate="{StaticResource ActivityMetricTemplate}" ItemsSource="{Binding SecondaryCards}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

  "cards": [
    {
      "dot": "cyan",
      "title": "Capture loop",
      "items": [
        "MonitoringRuntime samples on a ~1 s cadence (LiveRefreshCadence)",
        "Coordinator: discovery → attribution → process metrics → disk/network/GPU stages",
        "Snapshot hub: one bounded 1-slot channel per subscriber, DropOldest"
      ]
    },
    {
      "dot": "amber",
      "title": "Privilege & safety",
      "items": [
        "Main app runs unelevated; kernel ETW only via the LocalSystem broker",
        "Per-user pipe name, magic + version frames, 64 KB request / 4 MB response bounds",
        "Process actions revalidate PID + start time before acting",
        "ElevatedHelper exists but exposes no privileged operation (deliberate stub)"
      ]
    },
    {
      "dot": "violet",
      "title": "Data & history",
      "items": [
        "SQLite history.db under %LocalAppData%\\MonitoringXS (Microsoft.Data.Sqlite)",
        "24 h retention, 1 h raw samples, downsampling, write queue capped at 256",
        "Unavailable metrics are shown as unavailable, never as zero"
      ]
    }
  ]
